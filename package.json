{
  "name": "employee-verification-system",
  "version": "1.0.0",
  "private": true,
  "description": "Employee Verification System - printable QR ID cards with a public, company-branded verification page.",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx workers/import-worker.ts",
    "retention": "tsx scripts/purge-scan-logs.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "postinstall": "prisma generate",
    "db:demo": "tsx scripts/demo.ts",
    "db:clear-demo": "tsx scripts/demo-clear.ts",
    "init-env:prod": "tsx scripts/init-env-prod.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@node-rs/argon2": "2.0.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "adm-zip": "^0.6.1",
    "bidi-js": "1.1.0",
    "bullmq": "6.5.3",
    "exceljs": "4.4.0",
    "ioredis": "5.11.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.66.0",
    "mupdf": "^1.28.1",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^17.2.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.0"
  }
}
