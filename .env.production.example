# Bremer production environment template.
# Copy to .env with: npm run init-env:prod
NODE_ENV=production
PORT=3000

# Public HTTPS addresses (no trailing slash).
APP_URL=https://app.yourdomain.com
AUTH_URL=https://app.yourdomain.com
PUBLIC_BASE_URL=https://app.yourdomain.com

AUTH_SECRET=
AUTH_TRUST_HOST=true
TRUSTED_PROXY=proxy
TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgresql://evs:CHANGE_ME@postgres:5432/evs?schema=public
POSTGRES_PASSWORD=

TOTP_ENCRYPTION_KEY=
CARD_TOKEN_KEY=
IP_HASH_SALT=
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL=300
CRON_SECRET=

STORAGE_DIR=/app/storage
MAX_SPREADSHEET_BYTES=10485760
MAX_ZIP_BYTES=94371840
MAX_IMAGE_BYTES=5242880
MAX_IMPORT_ROWS=5000

REDIS_URL=redis://redis:6379
BULLMQ_ENABLED=true

REQUIRE_2FA=true
ALLOW_NO_2FA=false
COPYRIGHT_TEXT=© {year} Tawthiq

SEED_COMPANY_PHONE=+20 100 000 0000
SEED_COMPANY_EMAIL=hr@bremer.example
SEED_SUPERADMIN_EMAIL=owner@bremer.example
SEED_SUPERADMIN_PASSWORD=

BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

TUNNEL_TOKEN=
