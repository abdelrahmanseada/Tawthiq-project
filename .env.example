# Bremer â€” environment example. Copy to .env and replace every placeholder secret.
# The UI is English-only; Arabic files remain dormant and are not loaded.

NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

DEFAULT_TIME_ZONE=Africa/Cairo
ALLOWED_SCRIPTS=latin
COPYRIGHT_TEXT=© {year} Tawthiq

# QR links are {PUBLIC_BASE_URL or Company settings URL}/v/{token}.
# Production must be HTTPS, public, and port 443. Development may use a LAN/tunnel URL.
PUBLIC_VERIFY_URL=http://localhost:3000

# Extra browser origins allowed to POST admin actions (comma-separated).
ALLOWED_ORIGINS=

DATABASE_URL=postgresql://evs:evs-local-password@127.0.0.1:5432/evs?schema=public

AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TRUST_HOST=true
SESSION_MAX_AGE=28800
IDLE_TIMEOUT_MINUTES=60

TOTP_ENCRYPTION_KEY=REPLACE_WITH_32_BASE64URL_BYTES
CARD_TOKEN_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
IP_HASH_SALT=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
MEDIA_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
MEDIA_URL_TTL=300
CRON_SECRET=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS

STORAGE_DIR=./storage
MAX_SPREADSHEET_BYTES=10485760
MAX_ZIP_BYTES=94371840
MAX_IMAGE_BYTES=5242880
MAX_IMPORT_ROWS=5000

REDIS_URL=
BULLMQ_ENABLED=false

# none | cloudflare. Cloudflare uses CF-Connecting-IP as the real client address.
TRUSTED_PROXY=none
TRUSTED_PROXY_HOPS=1

# 2FA is mandatory by default. In development/staging it may be disabled with
# REQUIRE_2FA=false. Production refuses ALLOW_NO_2FA=false.
REQUIRE_2FA=true
ALLOW_NO_2FA=false

BACKUP_PASSPHRASE=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Seed owner (forced password change and forced 2FA unless disabled above).
SEED_COMPANY_PHONE=+20 100 000 0000
SEED_COMPANY_EMAIL=hr@bremer.example
SEED_SUPERADMIN_EMAIL=owner@bremer.example
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026

TUNNEL_TOKEN=

E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=E2e!Password2026

# PowerShell secrets:
#   function New-Secret([int]$bytes = 48) {
#     $b = New-Object byte[] $bytes
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [Convert]::ToBase64String($b).Replace('+','-').Replace('/','_').TrimEnd('=')
#   }
#   New-Secret 48   # AUTH_SECRET, CARD_TOKEN_KEY, BACKUP_PASSPHRASE
#   New-Secret 32   # TOTP_ENCRYPTION_KEY, IP_HASH_SALT, MEDIA_SIGNING_SECRET, CRON_SECRET
