# ─────────────────────────────────────────────────────────────────────────────
# Tawthiq — environment example
# Copy to .env and replace every placeholder secret.
# The UI is English-only; Arabic assets are dormant and not loaded.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
APP_URL=http://localhost:3000
PORT=3000

DEFAULT_TIME_ZONE=Africa/Cairo
SUPPORT_URL=https://support.tawthiq.example
ALLOWED_SCRIPTS=latin

# Full public URL used to build QR links ({PUBLIC_VERIFY_URL}/v/{token}).
# Production MUST be https with a public host and port 443.
# Local phone testing: use https://<your-tunnel> or http://<LAN-IP>:3000 in development.
PUBLIC_VERIFY_URL=http://localhost:3000

# Optional extra browser origins allowed to POST admin actions (comma-separated).
ALLOWED_ORIGINS=

# PostgreSQL connection string.
DATABASE_URL=postgresql://evs:evs-local-password@127.0.0.1:5432/evs?schema=public

# Auth.js
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
SESSION_MAX_AGE=28800
IDLE_TIMEOUT_MINUTES=60

# Secrets. Generate each with the PowerShell snippet below (or openssl rand -base64 32).
TOTP_ENCRYPTION_KEY=REPLACE_WITH_32_BASE64URL_BYTES
CARD_TOKEN_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
IP_HASH_SALT=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
MEDIA_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
MEDIA_URL_TTL=300
CRON_SECRET=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS

# Storage and uploads
STORAGE_DIR=./storage
MAX_SPREADSHEET_BYTES=10485760
MAX_ZIP_BYTES=209715200
MAX_IMAGE_BYTES=5242880
MAX_IMPORT_ROWS=5000

# Redis/BullMQ is optional. Empty REDIS_URL uses in-process imports and Postgres/
# memory rate limiting.
REDIS_URL=
BULLMQ_ENABLED=false

# Number of trusted reverse proxies to skip from the right of X-Forwarded-For.
# 0 = use the socket peer address; 1 = one proxy (typical nginx/Caddy).
TRUSTED_PROXY_HOPS=1

# Encrypted backups (npm run backup / npm run restore)
BACKUP_PASSPHRASE=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Demo seed (dev only; db:reset-demo refuses NODE_ENV=production).
SEED_COMPANY_PHONE=+20 100 000 0000
SEED_COMPANY_EMAIL=hr@example.com
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026
PLATFORM_ADMIN_NAME=Platform Operator
PLATFORM_ADMIN_EMAIL=platform@tawthiq.example
PLATFORM_ADMIN_PASSWORD=ChangeMe!2026

# E2E tests (Playwright) use these only inside tests/e2e.
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=E2e!Password2026

# ─────────────────────────────────────────────────────────────────────────────
# PowerShell secret generation (run once, copy each value into .env):
#
#   function New-Secret([int]$bytes = 48) {
#     $b = New-Object byte[] $bytes
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     [Convert]::ToBase64String($b).Replace('+','-').Replace('/','_').TrimEnd('=')
#   }
#   New-Secret 48   # AUTH_SECRET, CARD_TOKEN_KEY, BACKUP_PASSPHRASE
#   New-Secret 32   # TOTP_ENCRYPTION_KEY (must decode to 32 bytes), IP_HASH_SALT,
#                    # MEDIA_SIGNING_SECRET, CRON_SECRET
#
# TOTP_ENCRYPTION_KEY must be 32 base64url bytes:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace('+','-').Replace('/','_').TrimEnd('=')
#
# Linux/macOS:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# ─────────────────────────────────────────────────────────────────────────────
